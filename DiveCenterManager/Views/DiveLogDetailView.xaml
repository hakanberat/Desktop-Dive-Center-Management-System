<UserControl x:Class="DiveCenterManager.Views.DiveLogDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DiveCenterManager.Views"
             AutomationProperties.Name="Dive log details">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}"/>
            <TextBlock Text="Shared Dive Information" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Width="235" Margin="0,0,16,16">
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Shared notes" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Diver Logs" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <WrapPanel>
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding Command}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
            <views:RecordGrid ColumnDefinitions="{Binding Columns}" ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}" Height="275" AutomationProperties.Name="Diver logs"/>
            <TextBlock Text="{Binding ResultCount}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
