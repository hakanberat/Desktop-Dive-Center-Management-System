<UserControl x:Class="DiveCenterManager.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DiveCenterManager.Views"
             AutomationProperties.Name="Cash transactions">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}" Margin="0,6,0,12"/>
            <WrapPanel Margin="0,0,0,4">
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding Command}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>
            <Border Style="{StaticResource Card}" Padding="14,12,0,0" Margin="0,0,0,8">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource FieldTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="150"/></Style></ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <WrapPanel>
                        <Button Content="Apply filters" Command="{Binding RefreshCommand}"/>
                        <Button Content="Clear Filters" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButton}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Expander Header="Cash balances by currency · same filters as the transaction list" IsExpanded="True" Margin="0,0,0,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="124" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Balances}" AutomationProperties.Name="Separate currency balances">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Width="150" Padding="10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Code}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="{Binding Income, Mode=OneWay, StringFormat='Income {0:#,##0.00##########################}'}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3" Text="{Binding Expense, Mode=OneWay, StringFormat='Expense {0:#,##0.00##########################}'}"/>
                                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Balance, Mode=OneWay, StringFormat='Balance {0:#,##0.00##########################}'}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,2,0,8">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResultCount}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
        <Grid>
            <views:RecordGrid x:Name="Records" ColumnDefinitions="{Binding Columns}" ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}" MouseDoubleClick="OnDoubleClick" PreviewKeyDown="OnKeyDown"
                              AutomationProperties.Name="Cash movement records"/>
            <Border Background="{StaticResource AlternateRowBrush}" Margin="1,42,1,1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="No cash movements to show" FontSize="20"/>
                    <TextBlock Text="Add an income or expense, or adjust the filters." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
