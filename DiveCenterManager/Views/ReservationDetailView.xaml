<UserControl x:Class="DiveCenterManager.Views.ReservationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DiveCenterManager.Views"
             AutomationProperties.Name="Reservation details">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}"/>
            <WrapPanel>
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding Command}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
            <Border Style="{StaticResource Card}" Margin="0,8,0,18">
                <ItemsControl ItemsSource="{Binding Details}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="240" Margin="0,0,18,18">
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="Reservation cash movements" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <TextBlock Text="{Binding PaymentSummary}" TextWrapping="Wrap"/>
            </Border>
            <views:RecordGrid ColumnDefinitions="{Binding PaymentColumns}" ItemsSource="{Binding Payments}" Height="240" AutomationProperties.Name="Reservation cash transactions"/>
            <TextBlock Text="{Binding PaymentCount}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
