<UserControl x:Class="DiveCenterManager.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiveCenterManager.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="Refresh dashboard" Command="{Binding RefreshCommand}" HorizontalAlignment="Right"/><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Today}" Style="{StaticResource Subtitle}"/></StackPanel></DockPanel>
    <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
    <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
    <ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="{Binding Label}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding Value}" FontSize="36" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Cash overview" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock Text="Today's cash movement and the balance of all saved transactions, separately for each currency." Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    <ItemsControl ItemsSource="{Binding Snapshot.Cash}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" MinWidth="205" Padding="16"><StackPanel><TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}"/><TextBlock Text="Cash balance" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><TextBlock Text="{Binding CurrentBalance, StringFormat={}{0:#,##0.00##########################}}" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,12"/><TextBlock Text="{Binding TodayIncome, StringFormat=Income today: {0:#,##0.00##########################}}" Foreground="{StaticResource SuccessBrush}" FontSize="12"/><TextBlock Text="{Binding TodayExpense, StringFormat=Expenses today: {0:#,##0.00##########################}}" Foreground="{StaticResource ExpenseBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Upcoming reservations · next 7 days" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,4"/>
    <TextBlock Text="Pending and confirmed bookings from today through the next six days." Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="No upcoming reservations in this period." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasUpcoming}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <local:RecordGrid ItemsSource="{Binding Snapshot.Upcoming}" ColumnDefinitions="{Binding UpcomingColumns}" Height="230" AutomationProperties.Name="Upcoming reservations"/>
    <TextBlock Text="Recent completed reservations" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,4"/>
    <TextBlock Text="The last six completed bookings." Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Text="No completed reservations have been recorded." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasRecentReservations}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <local:RecordGrid ItemsSource="{Binding Snapshot.RecentReservations}" ColumnDefinitions="{Binding RecentColumns}" Height="250" AutomationProperties.Name="Recent completed reservations"/>
  </StackPanel></ScrollViewer>
</UserControl>