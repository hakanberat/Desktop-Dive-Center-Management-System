<Window x:Class="DiveCenterManager.Views.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiveCenterManager.Views" Style="{StaticResource {x:Type Window}}" Title="{Binding Title}" Width="880" Height="810" MinWidth="740" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="26">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Hint}" Style="{StaticResource Subtitle}"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <Border Background="{StaticResource ErrorSurfaceBrush}" Padding="10" Margin="0,0,0,10"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"/></ScrollViewer></Border>
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsSaving, Converter={StaticResource BoolVisibility}}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Close / cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" IsCancel="True"/><Button Content="Save changes" Command="{Binding SaveCommand}" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}"/></StackPanel>
    </StackPanel>
    <TabControl Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="12"><TabControl.Style><Style TargetType="TabControl"><Style.Triggers><DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TabControl.Style>
      <TabItem Header="{Binding DetailsTabTitle}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <StackPanel Margin="0,0,0,16" Visibility="{Binding HasReference, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding ReferenceLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
          <TextBox Text="{Binding ReferenceValue, Mode=OneWay}" IsReadOnly="True" FontWeight="SemiBold" Margin="0,6,16,0"/>
        </StackPanel>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{StaticResource MutedBrush}"/>
        <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding CanEdit}" ItemTemplate="{StaticResource FieldTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="350"/></Style></ItemsControl.ItemContainerStyle></ItemsControl>
        <GroupBox Header="Staff roles · select all that apply" IsEnabled="{Binding CanEdit}" Visibility="{Binding HasRoles, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding Roles}" Margin="12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,5,22,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{Binding ChildrenTabTitle}"><TabItem.Style><Style TargetType="TabItem"><Style.Triggers><DataTrigger Binding="{Binding Children}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabItem.Style>
        <DockPanel DataContext="{Binding Children}"><StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Style="{StaticResource Subtitle}" Margin="0,8,0,14"/><TextBlock Text="{Binding CountSummary}" FontWeight="SemiBold" Margin="0,0,0,10"/><WrapPanel><Button Content="{Binding AddLabel}" Command="{Binding AddCommand}"/><Button Content="{Binding EditLabel}" Command="{Binding EditCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel><TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6"/></StackPanel><local:RecordGrid ColumnDefinitions="{Binding Columns}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"/></DockPanel>
      </TabItem>
      <TabItem Header="Payments"><TabItem.Style><Style TargetType="TabItem"><Style.Triggers><DataTrigger Binding="{Binding Payments}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabItem.Style>
        <DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,20"/><local:RecordGrid ColumnDefinitions="{Binding PaymentColumns}" ItemsSource="{Binding Payments}"/></DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>

