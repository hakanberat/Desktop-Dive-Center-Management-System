<UserControl x:Class="DiveCenterManager.Views.ScreenView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiveCenterManager.Views">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}"/>
      <ItemsControl ItemsSource="{Binding Cards}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="250"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Style="{StaticResource Card}" Padding="14,12,0,0" Margin="0,0,0,16" Visibility="{Binding HasFilters, Converter={StaticResource BoolVisibility}}"><StackPanel>
        <ItemsControl ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource FieldTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="185"/></Style></ItemsControl.ItemContainerStyle></ItemsControl>
        <WrapPanel><Button Content="Apply filters" Command="{Binding RefreshCommand}"/><Button Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
      </StackPanel></Border>
      <WrapPanel><ItemsControl ItemsSource="{Binding Actions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding Command}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel>
      <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResultCount}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
    <Grid><local:RecordGrid x:Name="Records" ColumnDefinitions="{Binding Columns}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"><local:RecordGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="{StaticResource GroupHeaderBrush}" Padding="12,10"><TextBlock Text="{Binding Name, StringFormat={}{0:dddd, dd MMMM yyyy}}" FontWeight="SemiBold"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></local:RecordGrid.GroupStyle></local:RecordGrid>
      <Border Background="{StaticResource AlternateRowBrush}" Margin="1,42,1,1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="No records to show" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="Add a record, or adjust the filters above." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
  </DockPanel>
</UserControl>
