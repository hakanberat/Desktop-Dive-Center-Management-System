<UserControl x:Class="DiveCenterManager.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DiveCenterManager.Views" AutomationProperties.Name="Reports">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}" Margin="0,6,0,12"/>
            <WrapPanel>
                <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                <ContentControl Content="{Binding ReportField}" ContentTemplate="{StaticResource FieldTemplate}" Width="340"/>
                <Button Content="Run report" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Margin="0,0,8,12"/>
                <Button Content="Clear filters" Command="{Binding ResetFiltersCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
            </WrapPanel>
            <Border Padding="12,10,0,0" Margin="0,0,0,10">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <ItemsControl ItemsSource="{Binding VisibleFilters}" ItemTemplate="{StaticResource FieldTemplate}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Width" Value="158"/></Style></ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Border>
            <TextBlock Text="{Binding ReportHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,8">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
            <StackPanel Visibility="{Binding HasActivityTotals, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="Activity totals" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,8"/>
                <views:RecordGrid ItemsSource="{Binding ActivityTotals}" ColumnDefinitions="{Binding ActivityColumns}" Height="125" Margin="0,0,0,10" AutomationProperties.Name="Activity count totals"/>
                <TextBlock Text="Income by activity and currency" FontWeight="SemiBold" Margin="0,0,0,8"/>
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResultCount}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
        <views:RecordGrid ItemsSource="{Binding Rows}" ColumnDefinitions="{Binding Columns}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutomationProperties.Name="Report results"/>
    </DockPanel>
</UserControl>
