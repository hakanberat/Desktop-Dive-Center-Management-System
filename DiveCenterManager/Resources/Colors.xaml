<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="DiveHubNavy">#0D2F4F</Color>
  <Color x:Key="DiveHubBlue">#2D6E8E</Color>
  <Color x:Key="DiveHubAccent">#20B5BD</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="BackgroundColor">#F2F6FA</Color>
  <Color x:Key="TextPrimaryColor">#18344C</Color>
  <Color x:Key="TextSecondaryColor">#60768A</Color>
  <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource DiveHubNavy}"/>
  <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource DiveHubBlue}"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource DiveHubAccent}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="BorderBrush">#DCE5ED</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorBrush">#AA303B</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorSurfaceBrush">#FFF0F1</SolidColorBrush>
  <SolidColorBrush x:Key="SuccessBrush">#28745B</SolidColorBrush>
  <SolidColorBrush x:Key="ExpenseBrush">#976048</SolidColorBrush>
  <SolidColorBrush x:Key="SecondarySurfaceBrush">#E4EDF4</SolidColorBrush>
  <SolidColorBrush x:Key="AlternateRowBrush">#F8FAFC</SolidColorBrush>
  <SolidColorBrush x:Key="GridLineBrush">#EDF2F6</SolidColorBrush>
  <SolidColorBrush x:Key="GridHeaderBrush">#EAF0F6</SolidColorBrush>
  <SolidColorBrush x:Key="GroupHeaderBrush">#DCEBF2</SolidColorBrush>
  <SolidColorBrush x:Key="SidebarTextBrush">#D6E5F0</SolidColorBrush>
  <SolidColorBrush x:Key="SidebarMutedBrush">#A2B6C9</SolidColorBrush>
  <SolidColorBrush x:Key="SidebarAccentBrush">#75CFD6</SolidColorBrush>
  <SolidColorBrush x:Key="SidebarSelectionBrush">#245371</SolidColorBrush>
  <SolidColorBrush x:Key="SidebarHoverBrush">#1D4564</SolidColorBrush>
  <SolidColorBrush x:Key="StatusCompleteBrush">#237155</SolidColorBrush>
  <SolidColorBrush x:Key="StatusCancelledBrush">#9B414D</SolidColorBrush>
  <SolidColorBrush x:Key="StatusRunningBrush">#256599</SolidColorBrush>
  <SolidColorBrush x:Key="StatusPendingBrush">#84662E</SolidColorBrush>
</ResourceDictionary>
