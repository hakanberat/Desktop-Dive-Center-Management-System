<Window x:Class="DiveCenterManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Dive Hub Management" Width="1440" Height="940" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource NavyBrush}"><DockPanel Margin="16,20,16,16">
      <StackPanel DockPanel.Dock="Top" Margin="12,0,12,18">
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="2" HorizontalAlignment="Left"><Image Source="Resources/Brand/dive-hub-logo.png" Width="56" Height="56" AutomationProperties.Name="Dive Hub logo"/></Border>
        <TextBlock Text="DIVE HUB" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,10,0,0"/>
        <TextBlock Text="M A N A G E M E N T" FontSize="10" Foreground="{StaticResource SidebarAccentBrush}" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="12,12,0,0"><TextBlock Text="●  Offline workspace" Foreground="{StaticResource SidebarAccentBrush}" FontSize="12"/><TextBlock Text="Your center. One place." Foreground="{StaticResource SidebarMutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
      <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation}" DisplayMemberPath="Title" Style="{StaticResource SidebarList}" ItemContainerStyle="{StaticResource SidebarItem}" AutomationProperties.Name="Main navigation"/>
    </DockPanel></Border>
    <DockPanel Grid.Column="1">
      <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="20,7"><MenuItem Header="_File"><MenuItem Header="_Backup Database" Command="{Binding BackupCommand}"/><MenuItem Header="Open Backup _Folder" Command="{Binding OpenBackupFolderCommand}"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem></Menu>
      <Border DockPanel.Dock="Top" Style="{StaticResource NoticeBanner}" Margin="28,12,28,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolVisibility}}">
        <DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissNoticeCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="Application notification"/></DockPanel>
      </Border>
      <ContentControl Content="{Binding Current}" Margin="28,24"/>
    </DockPanel>
  </Grid>
</Window>
